// Agent Design — single-user schema (no multi-tenant, no auth)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CreditTxType {
  GRANT
  PURCHASE
  USAGE
  REFUND
  ADJUSTMENT
}

model CreditTx {
  id           String       @id @default(cuid())
  userId       String       @default("owner")
  type         CreditTxType
  amount       Int
  balanceAfter Int
  reason       String       @default("")
  taskId       String?
  carouselId   String?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
}
